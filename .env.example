# Database Configuration
# For SQLite (default):
# DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/forum_downloader"
DATABASE_URL="file:./dev.db"

# Application Configuration
NODE_ENV="development"
PORT=3000

# NextAuth Configuration (optional, for future authentication features)
# NEXTAUTH_SECRET="your-secret-key-here"
# NEXTAUTH_URL="http://localhost:3000"

# Logging
LOG_LEVEL="info"
